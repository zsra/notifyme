<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>notifyme-api-a1e6f8b2-9c3d-4f7a-8e1b-6d2c5a9f0e3b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      Required by the EF Core CLI tools (`dotnet ef`) whenever this project is passed as the
      startup project; not used at runtime. Infrastructure also references this with
      PrivateAssets="all", which is why it doesn't flow through transitively.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!--
      Microsoft.AspNetCore.OpenApi 10.0.10 depends on Microsoft.OpenApi >= 2.0.0 (no upper bound),
      which resolves to the vulnerable 2.0.0 by default (GHSA-v5pm-xwqc-g5wc, fixed in 2.7.5).
      Pin explicitly to the latest patched 2.x release to stay within the same major version
      Microsoft.AspNetCore.OpenApi was built against, rather than jumping to the breaking 3.x line.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NotifyMe.Domain\NotifyMe.Domain.csproj" />
    <ProjectReference Include="..\NotifyMe.Application\NotifyMe.Application.csproj" />
    <ProjectReference Include="..\NotifyMe.Infrastructure\NotifyMe.Infrastructure.csproj" />
  </ItemGroup>

</Project>
